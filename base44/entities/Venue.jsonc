{
  "name": "Venue",
  "type": "object",
  "properties": {
    "ground_mode": {
      "type": "string",
      "enum": [
        "turf",
        "circular"
      ],
      "default": "turf",
      "description": "Which app mode this venue belongs to (venues are separate per mode)"
    },
    "name": {
      "type": "string",
      "description": "Venue name"
    },
    "location": {
      "type": "string",
      "description": "City, area or ground address"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}