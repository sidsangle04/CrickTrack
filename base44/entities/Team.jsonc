{
  "name": "Team",
  "type": "object",
  "properties": {
    "ground_mode": {
      "type": "string",
      "enum": [
        "turf",
        "circular"
      ],
      "default": "turf",
      "description": "Which app mode this team belongs to (rosters are separate per mode)"
    },
    "name": {
      "type": "string",
      "description": "Team name"
    },
    "short_name": {
      "type": "string",
      "description": "3-4 letter abbreviation"
    },
    "logo_url": {
      "type": "string",
      "description": "Team logo image URL"
    },
    "home_ground": {
      "type": "string",
      "description": "Home venue"
    },
    "primary_color": {
      "type": "string",
      "description": "Team primary color hex"
    }
  },
  "required": [
    "name",
    "short_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}