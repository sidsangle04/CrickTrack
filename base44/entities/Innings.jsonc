{
  "name": "Innings",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string",
      "description": "Reference to Match"
    },
    "innings_number": {
      "type": "number",
      "description": "1 or 2 for regular, 3+ for super overs"
    },
    "batting_team_id": {
      "type": "string"
    },
    "bowling_team_id": {
      "type": "string"
    },
    "is_super_over": {
      "type": "boolean",
      "default": false
    },
    "super_over_number": {
      "type": "number",
      "description": "Which super over (1, 2, etc.)"
    },
    "total_runs": {
      "type": "number",
      "default": 0
    },
    "total_wickets": {
      "type": "number",
      "default": 0
    },
    "total_overs": {
      "type": "number",
      "default": 0,
      "description": "Completed overs"
    },
    "total_balls": {
      "type": "number",
      "default": 0,
      "description": "Legal balls bowled"
    },
    "extras_wide": {
      "type": "number",
      "default": 0
    },
    "extras_no_ball": {
      "type": "number",
      "default": 0
    },
    "extras_byes": {
      "type": "number",
      "default": 0
    },
    "extras_leg_byes": {
      "type": "number",
      "default": 0
    },
    "extras_penalty": {
      "type": "number",
      "default": 0
    },
    "target": {
      "type": "number",
      "description": "Target for 2nd innings"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "not_started"
    },
    "end_reason": {
      "type": "string",
      "enum": [
        "all_out",
        "overs_complete",
        "target_reached",
        "declared",
        "forfeited"
      ],
      "description": "How innings ended"
    },
    "current_striker_id": {
      "type": "string"
    },
    "current_non_striker_id": {
      "type": "string"
    },
    "current_bowler_id": {
      "type": "string"
    },
    "current_over_number": {
      "type": "number",
      "default": 0
    },
    "current_ball_in_over": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "match_id",
    "innings_number",
    "batting_team_id",
    "bowling_team_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}