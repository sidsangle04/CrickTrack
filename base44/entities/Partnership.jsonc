{
  "name": "Partnership",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string"
    },
    "innings_id": {
      "type": "string"
    },
    "is_shared": {
      "type": "boolean",
      "default": false,
      "description": "Mirrors the parent match's sharing state; true lets other signed-in users view this innings"
    },
    "wicket_number": {
      "type": "number",
      "description": "Partnership for which wicket (1-10)"
    },
    "batter1_id": {
      "type": "string"
    },
    "batter2_id": {
      "type": "string"
    },
    "runs": {
      "type": "number",
      "default": 0
    },
    "balls": {
      "type": "number",
      "default": 0
    },
    "batter1_runs": {
      "type": "number",
      "default": 0
    },
    "batter1_balls": {
      "type": "number",
      "default": 0
    },
    "batter2_runs": {
      "type": "number",
      "default": 0
    },
    "batter2_balls": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "how_ended": {
      "type": "string",
      "description": "Dismissal type that ended partnership"
    }
  },
  "required": [
    "match_id",
    "innings_id",
    "wicket_number",
    "batter1_id",
    "batter2_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.is_shared": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}