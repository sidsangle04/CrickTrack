{
  "name": "Partnership",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string"
    },
    "innings_id": {
      "type": "string"
    },
    "wicket_number": {
      "type": "number",
      "description": "Partnership for which wicket (1-10)"
    },
    "batter1_id": {
      "type": "string"
    },
    "batter2_id": {
      "type": "string"
    },
    "runs": {
      "type": "number",
      "default": 0
    },
    "balls": {
      "type": "number",
      "default": 0
    },
    "batter1_runs": {
      "type": "number",
      "default": 0
    },
    "batter1_balls": {
      "type": "number",
      "default": 0
    },
    "batter2_runs": {
      "type": "number",
      "default": 0
    },
    "batter2_balls": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "how_ended": {
      "type": "string",
      "description": "Dismissal type that ended partnership"
    }
  },
  "required": [
    "match_id",
    "innings_id",
    "wicket_number",
    "batter1_id",
    "batter2_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}