{
  "name": "Match",
  "type": "object",
  "properties": {
    "ground_mode": {
      "type": "string",
      "enum": [
        "turf",
        "circular"
      ],
      "default": "turf",
      "description": "Which app mode this match belongs to (TURF rectangular vs Circular). Filters all data separation."
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Match date"
    },
    "venue": {
      "type": "string",
      "description": "Match venue name"
    },
    "venue_id": {
      "type": "string",
      "default": "",
      "description": "Linked Venue id when the match was set up against a saved venue"
    },
    "team1_id": {
      "type": "string",
      "description": "First team ID"
    },
    "team2_id": {
      "type": "string",
      "description": "Second team ID"
    },
    "team1_playing_xi": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Team 1 playing XI player IDs"
    },
    "team2_playing_xi": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Team 2 playing XI player IDs"
    },
    "overs_per_innings": {
      "type": "number",
      "default": 20,
      "description": "Total overs per innings (limited-overs)"
    },
    "max_overs_per_bowler": {
      "type": "number",
      "description": "Max overs a bowler can bowl"
    },
    "ball_type": {
      "type": "string",
      "enum": [
        "leather",
        "tennis",
        "tape"
      ],
      "default": "leather"
    },
    "wide_runs": {
      "type": "number",
      "default": 1,
      "description": "Runs awarded for wide"
    },
    "no_ball_runs": {
      "type": "number",
      "default": 1,
      "description": "Runs awarded for no-ball"
    },
    "toss_winner_id": {
      "type": "string",
      "description": "Team that won toss"
    },
    "toss_decision": {
      "type": "string",
      "enum": [
        "bat",
        "bowl"
      ],
      "description": "Toss winner's decision"
    },
    "status": {
      "type": "string",
      "enum": [
        "setup",
        "live",
        "innings_break",
        "super_over",
        "completed",
        "abandoned"
      ],
      "default": "setup"
    },
    "current_innings": {
      "type": "number",
      "default": 1,
      "description": "Current innings number (1-4 for test, 1-2 for limited)"
    },
    "batting_team_id": {
      "type": "string",
      "description": "Currently batting team"
    },
    "bowling_team_id": {
      "type": "string",
      "description": "Currently bowling team"
    },
    "result": {
      "type": "string",
      "description": "Match result text"
    },
    "winner_id": {
      "type": "string",
      "description": "Winning team ID"
    },
    "tournament_match_id": {
      "type": "string",
      "default": "",
      "description": "Linked TournamentMatch id when this match is part of a tournament bracket"
    },
    "allow_multiple_super_overs": {
      "type": "boolean",
      "default": true
    },
    "super_over_count": {
      "type": "number",
      "default": 0
    },
    "unlimited_batters": {
      "type": "boolean",
      "default": false,
      "description": "Allow more than 11 batters (casual mode)"
    },
    "format": {
      "type": "string",
      "enum": [
        "limited",
        "test"
      ],
      "default": "limited",
      "description": "Match format: limited-overs or multi-innings Test"
    },
    "players_per_team": {
      "type": "number",
      "default": 11,
      "description": "Players per team (Test: drives Max_Wickets = players_per_team - 1)"
    },
    "is_over_limited": {
      "type": "boolean",
      "default": false,
      "description": "Test: whether a global match over cap is enforced"
    },
    "total_match_overs": {
      "type": "number",
      "description": "Test: global over limit for the entire match"
    },
    "follow_on_enforced": {
      "type": "boolean",
      "default": false,
      "description": "Test: whether the team batting first enforced the follow-on"
    },
    "enable_visual_tagging": {
      "type": "boolean",
      "default": true,
      "description": "Whether ball-by-ball visual tagging (pitch zone, shot location, delivery details) is prompted during scoring. False = quick scoring (outcomes only)."
    },
    "prematch_team1_pct": {
      "type": "number",
      "description": "Pre-match win probability for team 1 (%)"
    },
    "prematch_team2_pct": {
      "type": "number",
      "description": "Pre-match win probability for team 2 (%)"
    },
    "prematch_summary": {
      "type": "string",
      "description": "Short summary of the drivers behind the pre-match prediction"
    }
  },
  "required": [
    "date",
    "venue",
    "team1_id",
    "team2_id",
    "overs_per_innings"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}