{
  "name": "Tournament",
  "type": "object",
  "properties": {
    "ground_mode": {
      "type": "string",
      "enum": [
        "turf",
        "circular"
      ],
      "default": "turf",
      "description": "Which app mode this tournament belongs to (TournamentMatch inherits this)"
    },
    "name": {
      "type": "string",
      "description": "Tournament name"
    },
    "team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Participating team IDs"
    },
    "num_teams": {
      "type": "number",
      "default": 0,
      "description": "Number of teams in the tournament"
    },
    "format": {
      "type": "string",
      "enum": [
        "knockout",
        "league_knockout"
      ],
      "default": "knockout",
      "description": "Tournament format: pure knockout or round-robin league then knockout"
    },
    "knockout_teams": {
      "type": "number",
      "default": 4,
      "description": "How many teams qualify from the league stage to the knockout (power of two)"
    },
    "status": {
      "type": "string",
      "enum": [
        "setup",
        "in_progress",
        "completed"
      ],
      "default": "setup",
      "description": "Tournament status"
    },
    "champion_team_id": {
      "type": "string",
      "description": "Winning team of the tournament"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}