{
  "name": "Tournament",
  "type": "object",
  "properties": {
    "ground_mode": {
      "type": "string",
      "enum": [
        "turf",
        "circular"
      ],
      "default": "turf",
      "description": "Which app mode this tournament belongs to (TournamentMatch inherits this)"
    },
    "name": {
      "type": "string",
      "description": "Tournament name"
    },
    "creation_mode": {
      "type": "string",
      "enum": [
        "direct",
        "auction"
      ],
      "enumColors": [
        "gray",
        "purple"
      ],
      "default": "direct",
      "description": "direct = teams picked from the Teams section (players already added), auction = teams created here and squads filled by the auction"
    },
    "team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Participating team IDs"
    },
    "num_teams": {
      "type": "number",
      "default": 0,
      "description": "Number of teams in the tournament"
    },
    "format": {
      "type": "string",
      "enum": [
        "knockout",
        "league_knockout",
        "league_playoffs",
        "league_qualifiers"
      ],
      "default": "knockout",
      "description": "Tournament format: pure knockout; round-robin league then a knockout bracket; league then playoffs (topper straight to final, 2nd vs 3rd semifinal); or league then qualifiers (Qualifier 1, Eliminator, Qualifier 2, Final). Playoff and qualifier formats need at least 4 teams."
    },
    "knockout_teams": {
      "type": "number",
      "default": 4,
      "description": "How many teams qualify from the league stage into the knockout, playoffs or qualifiers"
    },
    "knockout_pairing": {
      "type": "string",
      "enum": [
        "standard",
        "adjacent",
        "cross"
      ],
      "default": "standard",
      "description": "How the knockout pairs teams: standard = 1st vs 4th (seeds kept apart), adjacent = 1st vs 2nd as listed, cross = 1st vs 3rd"
    },
    "status": {
      "type": "string",
      "enum": [
        "setup",
        "in_progress",
        "completed"
      ],
      "default": "setup",
      "description": "Tournament status"
    },
    "champion_team_id": {
      "type": "string",
      "description": "Winning team of the tournament"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}