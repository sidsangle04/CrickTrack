{
  "name": "AuctionIconDraw",
  "type": "object",
  "properties": {
    "tournament_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "team_name": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "bowl": {
      "type": "string",
      "enum": [
        "bowl1",
        "bowl2"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "assigned",
        "replaced"
      ],
      "enumColors": [
        "green",
        "yellow"
      ]
    },
    "replaced_player_id": {
      "type": "string",
      "description": "Player sent back to the bowl during a re-selection"
    },
    "replaced_player_name": {
      "type": "string"
    }
  },
  "required": [
    "tournament_id",
    "team_id",
    "player_id",
    "bowl",
    "action"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}