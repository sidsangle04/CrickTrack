{
  "name": "Match Report Email",
  "description": "Emails an HTML match report with the result, scorecard and top performers to the account that scored it, as soon as the match is marked complete.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Match",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"completed\" and .trigger.old_data.status != \"completed\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "match_report_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_report": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendMatchReport",
            "args": {
              "match_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Email match report",
            "description": "Result and scorecard"
          }
        }
      }
    ]
  }
}